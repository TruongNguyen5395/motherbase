<?xml version="1.0" encoding="utf-8"?>
<!-- The white MotherBase hexagonal M emblem, centered in the 108dp adaptive grid (used on Gradient and Mono Dark). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="@string/launcher_mark_outer" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="@string/launcher_mark_inner" />
</vector>
