<?xml version="1.0" encoding="utf-8"?>
<!-- The MotherBase hexagonal M emblem cropped to fill the status bar's 24dp notification icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="66"
    android:viewportHeight="66">
    <group
        android:translateX="-21"
        android:translateY="-21">
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="@string/launcher_mark_outer" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="@string/launcher_mark_inner" />
    </group>
</vector>
